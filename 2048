void movezero(int line[4]){
  int a=0;
  int temp[4]={0};
  for(int j=0;j<4;j++){
    if(line[j]!=0){
     temp[a]=line[j];
      a++;
    }
  }
  memcpy(line,temp,4*sizeof(int));
}
void merge(int line[4]){
 movezero(line);
      for(int j=0;j<3;j++){
        if(line[j]==line[j+1]){
          line[j]*=2;
          line[j+1]=0;
        }
      }
      movezero(line);
}
