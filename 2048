void initmap(game *eosb){
     for(int i=0;i<4;i++){
      for(int j=0;j<4;j++){
        eosb->map[i][j]=0;
      }
     }
}
void addsum(game *eosb){
     int temp[16][2];//创建新的数组存入0的位置
     int a=0;
     for(int i=0;i<4;i++){
      for(int j=0;j<4;j++){
        if(eosb->map[i][j]==0){
            temp[a][0]=i;
            temp[a][1]=j;
            a++;
        }
      }
     }
     //先决定要填充数字的数组位置随机
     if(a==0){
      return;
     }
     int addnumber=rand()%a;
     //有除零风险
     eosb->map[temp[addnumber][0]][temp[addnumber][1]]=initnumber();

}
