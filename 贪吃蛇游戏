#include<stdio.h>
#include<stdlib.h>
#include<time.h>
#include<windows.h>
#include<ctype.h>
#include<conio.h>
#include<stdbool.h>
#define MAP_WIDTH  60
#define MAP_HEIGHT 20
#define MAX_SPEED 200
#define MIN_SPEED 1000
//初始化全局变量
int food_x=0,food_y=0;
int currentspeed=MIN_SPEED,currentscore=0;
char dir='D';
char olddir='D';
time_t game_start_time;
time_t game_end_time;
time_t game_current_time;
//还未free链表
//先定义完整即使用typedef
typedef struct Snake {
      int snake_x;
      int snake_y;
    struct Snake *next;
}Snake;
//初始化控制台光标
void gotoxy(int x,int y){
  COORD pos={x,y};
  SetConsoleCursorPosition(GetStdHandle(STD_OUTPUT_HANDLE),pos);   
}
//可以选择光标隐藏！！！！
//隐藏光标
void hideCursor(){
     CONSOLE_CURSOR_INFO cci;
     cci.bVisible=FALSE;
     cci.dwSize=1;
     SetConsoleCursorInfo(GetStdHandle(STD_OUTPUT_HANDLE),&cci);

}
//绘制地图边界
void drawmap(){
  //上边界
     for(int x=0;x<MAP_WIDTH;x++){
      gotoxy(x,0);
      printf("#");
     }
  //下边界
      for(int x=0;x<MAP_WIDTH;x++){
      gotoxy(x,MAP_HEIGHT);
      printf("#");
     }
  //左边界
      for(int y=0;y<MAP_HEIGHT;y++){
      gotoxy(0,y);
      printf("#");
     }
  //右边界
      for(int y=0;y<MAP_HEIGHT;y++){
      gotoxy(MAP_WIDTH,y);
      printf("#");
     }
}
//蛇的新头,食物的x,y 随机生成！！！！
void randnum(int *x,int *y){
  
  *x=(rand()%(MAP_WIDTH-2))+1;
  *y=(rand()%(MAP_HEIGHT-2))+1;
}
//先定义链表，存入蛇的信息
//此处snake指针为定义链表头指针！！！！二级指针
void addsnake(Snake **snake,int x,int y){
    Snake *snakenew=(Snake*)calloc(1,sizeof(Snake));
    //记得释放内存最后！！！
    if(snakenew==NULL){
      printf("memory alloc failed!\n");
      exit(0);
    }
     snakenew->snake_x=x;
     snakenew->snake_y=y;
    snakenew->next=*snake;
    *snake=snakenew;
    gotoxy(x,y);
    printf("0");
}
//初始化开始的蛇位置和长度
//此处snake指针为定义链表头指针！！！！二级指针
void initsnake(Snake **snake){
    int m=MAP_WIDTH/2;
    int n=MAP_HEIGHT/2;
    addsnake(snake,m-2,n);
    addsnake(snake,m-1,n);
    addsnake(snake,m,n);
}
//判断是否会与蛇身重合
bool isonline(Snake *head,int x,int y){
  if (head == NULL) return false;
    Snake *p=head->next;
     while(p!=NULL){
      if(p->snake_x==x&&p->snake_y==y){
        return true;
      }
     p=p->next;
     }
     return false;
}
//创建食物
void creatfood(Snake *head){
   do{
      randnum(&food_x,&food_y);
   }while(isonline(head,food_x,food_y));
   gotoxy(food_x,food_y);
   printf("●");
}
//打印蛇
void printfsnake(Snake *snake){
     Snake *p=snake;
     while(p!=NULL){
      gotoxy(p->snake_x,p->snake_y);
      printf("0");
      p=p->next;
     }
}
//普通移动删链表蛇尾操作
//此处snake指针为定义链表头指针！！！！二级指针
void removesnake(Snake **snake){
  Snake *temp=*snake;
  if(temp==NULL||temp->next==NULL){return;}
     while(temp->next->next!=NULL){
      temp=temp->next;    
     }
     gotoxy(temp->next->snake_x,temp->next->snake_y);
     printf(" ");

     free(temp->next);
     //避免野指针！！！！！
     temp->next=NULL;
}
//蛇是否吃到食物
bool isgetfood(int x,int y){
      if(x==food_x&&y==food_y){
        return true;
      }
     return false;
}
//移动当前速度计算
int speed(int score){
  if(currentspeed<MAX_SPEED){
    return MAX_SPEED;
  }
    currentspeed-=50;
    return currentspeed;
}
//蛇头的方向移动
void direction(Snake **snake){
  //阻塞按键设置，默认移动方向设置
     if(_kbhit()){
      dir=toupper(getch());
     }
     if(olddir=='W'&&dir=='S'||olddir=='S'&&dir=='W'||olddir=='A'&&dir=='D'||olddir=='D'&&dir=='A'){
      dir=olddir;
     }
     Snake *head=*snake;
     int newx=head->snake_x;
     int newy=head->snake_y;
     switch(dir){
      case 'W':newy--;break;
      case 'A':newx--;break;
      case 'D':newx++;break;
      case 'S':newy++;break;
      default:
      break;
     }
     //是否撞墙或撞自己身
     if(newx==0||newx==MAP_WIDTH||newy==0||newy==MAP_HEIGHT){
      gotoxy(MAP_WIDTH+2,4);
      printf("You died!!!(zhuang qian)");
      Sleep(1000);
      exit(0);
     }
     if(isonline(head,newx,newy)){
      gotoxy(MAP_WIDTH+2,4);
      printf("You died!!!(zhuang zhi ji)");
      Sleep(1000);
      exit(0);
     }
     if(isgetfood(newx,newy)){
        currentscore+=15;
        creatfood(*snake);
        addsnake(snake,newx,newy);
        currentspeed=speed(currentscore);
     }
    else{
     addsnake(snake,newx,newy);
     removesnake(snake);}
     olddir=dir;
}
//释放链表内存
void freeSnake(Snake **snake){
      Snake *p=*snake;
      while(p!=NULL){
        Snake *temp=p;
        p=p->next;
        free(temp);
      }
      //特殊其他为局部变量而二级指针不是单独处理！！！！
      *snake=NULL;
}

int main(void){
  srand(time(NULL));
  system("mode con cols=100 lines=30");
  system("title 欢迎来到贪吃蛇游戏！！！请开始游戏吧！！！\n");
  hideCursor();
  printf("If start the game(Y/N):\n");
  char choice=toupper(getch());
  if(choice!='Y'){return 0;}
  Snake *snakehead;
  snakehead=NULL;
  currentspeed=MIN_SPEED;
  game_start_time=time(NULL);
  
 
  while(1){
    system("cls");
    if(snakehead==NULL){
     initsnake(&snakehead);
  creatfood(snakehead);}
  gotoxy(food_x,food_y);
  printf("●");
  drawmap();
      gotoxy(MAP_WIDTH+2,0);
      game_current_time=time(NULL);
      printf("Current time:%ld s",game_current_time-game_start_time);
      gotoxy(MAP_WIDTH+2,2);
      printf("Speed: %d ms", currentspeed);
      gotoxy(MAP_WIDTH+2,4);
      printf("You got scores:%d",currentscore);
      direction(&snakehead);
      printfsnake(snakehead);
      Sleep(currentspeed);
  }  
  gotoxy(MAP_WIDTH+2,4);
  printf("You got scores:%d",currentscore);
  gotoxy(MAP_WIDTH+2,1);
  game_end_time=time(NULL);
  printf("You have played the time:%ld s",game_end_time-game_start_time);
  freeSnake(&snakehead);
  return 0;
}
